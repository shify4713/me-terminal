-- ============================================================
--  Раскладка экрана
-- ============================================================
local HEADER_Y      = 1
local SEP_Y         = 2
local COLHEAD_Y      = 3
local CONTENT_TOP    = 4
local CONTENT_BOTTOM = h - 2          -- последние 2 строки — под статус-бар
local VISIBLE_ROWS   = CONTENT_BOTTOM - CONTENT_TOP + 1

local BTN_REFRESH_X1, BTN_REFRESH_X2 = 108, 123
local BTN_UP_X, BTN_DOWN_X           = 125, 128
local BTN_CANCEL_X1, BTN_CANCEL_X2   = 138, 157

local COUNT_POS = {56, 62, 68, 74, 80, 86}
local COUNT_VAL = {1, 3, 5, 10, 20, 50}
local COUNT_COLOR = {0x26A69A, 0x29B6F6, 0x66BB6A, 0xFFA726, 0xAB47BC, 0xEC407A}

local crafting = false
local cancel = false
local currentCraft = 0
local scrollOffset = 0   -- индекс (0-based) первого показанного предмета

local maxScroll = math.max(0, #items - VISIBLE_ROWS)

local function clampScroll()
    if scrollOffset < 0 then scrollOffset = 0 end
    if scrollOffset > maxScroll then scrollOffset = maxScroll end
end

-- Строка экрана для индекса предмета i (может быть вне видимой области)
local function rowY(i)
    return CONTENT_TOP + (i - 1 - scrollOffset)
end

-- Индекс предмета по клику на строку экрана y (или nil, если мимо списка)
local function indexAtY(y)
    if y < CONTENT_TOP or y > CONTENT_BOTTOM then return nil end
    local idx = scrollOffset + (y - CONTENT_TOP) + 1
    if idx >= 1 and idx <= #items then return idx end
    return nil
end

-- ============================================================
--  Работа с ME
-- ============================================================
local function getQty(id, dmg)
    local ok, data = pcall(function()
        return ae.getItemDetail({id = id, dmg = dmg})
    end)
    if ok and data then
        return data.all().qty or 0
    end
    return 0
end

local function shortNum(n)
    if n >= 1000000 then
        return string.format("%.1fM", n / 1000000)
    elseif n >= 1000 then
        return string.format("%.1fk", n / 1000)
    else
        return tostring(n)
    end
end

local function exportItems(id, dmg, amount)
    local exported = 0
    local remaining = amount
    while remaining > 0 and not cancel do
        local ok, detail = pcall(function()
            return ae.getItemDetail({id = id, dmg = dmg})
        end)
        if not ok or not detail then break end
        local stack = detail.all()
        if not stack or not stack.qty or stack.qty <= 0 then break end

        local toExport = math.min(remaining, 64)
        local success, result = pcall(function()
            return ae.exportItem({id = id, dmg = dmg}, EXPORT_SIDE, toExport)
        end)

        if success and result and result.size and result.size > 0 then
            exported = exported + result.size
            remaining = remaining - result.size
        else
            success, result = pcall(function()
                return ae.exportItem(stack, EXPORT_SIDE, toExport)
            end)
            if success and result and result.size and result.size > 0 then
                exported = exported + result.size
                remaining = remaining - result.size
            else
                break
            end
        end

        local e, _, x, y = event.pull(0, "touch")
        if e == "touch" and x >= BTN_CANCEL_X1 and y == HEADER_Y then
            cancel = true
            computer.beep(200, 0.05)
            break
        end
    end
    return exported
end

local function setStatus(text, color)
    gpu.setBackground(0x1C1C28)
    gpu.setForeground(color or 0xDDDDDD)
    gpu.fill(1, h - 1, w, 2, " ")
    gpu.set(2, h - 1, text)
end

-- ============================================================
--  Отрисовка
-- ============================================================

-- Рисует одну строку предмета i, если она попадает в видимую область
local function drawRow(i, highlight)
    local item = items[i]
    local y = rowY(i)
    if y < CONTENT_TOP or y > CONTENT_BOTTOM then return end

    if highlight then
        gpu.setBackground(0x1B5E20)
    elseif i % 2 == 0 then
        gpu.setBackground(0x1C1C2A)
    else
        gpu.setBackground(0x161622)
    end
    gpu.fill(1, y, w, 1, " ")

    gpu.setForeground(0x4A4A60)
    gpu.set(1, y, "▌")

    gpu.setForeground(0xFF8A80)
    gpu.set(3, y, item.name)

    gpu.setForeground(0xB0BEC5)
    gpu.set(20, y, tostring(item.need))

    local have = getQty(item.block, item.dmg)
    gpu.setForeground(0xEEEEEE)
    gpu.set(28, y, tostring(have))

    local can = math.floor(have / item.need)
    gpu.setForeground(can > 0 and 0x69F0AE or 0xFF5252)
    gpu.set(38, y, "+" .. can)

    local sings = getQty(item.singu, item.sDmg)
    gpu.setForeground(0xFFE082)
    gpu.set(47, y, tostring(sings))

    for b = 1, 6 do
        gpu.setForeground(0x2A2A3C)
        gpu.set(COUNT_POS[b] - 1, y, "│")
        gpu.setForeground(COUNT_COLOR[b])
        gpu.set(COUNT_POS[b], y, " + ")
    end

    gpu.setForeground(0x80CBC4)
    gpu.set(94, y, shortNum(have))
end

-- Обновляет только цифры видимых строк (без полной перерисовки)
local function updateNumbers()
    for i = scrollOffset + 1, math.min(scrollOffset + VISIBLE_ROWS, #items) do
        drawRow(i, i == currentCraft)
    end
    setStatus("Цифры обновлены", 0x80CBC4)
end

local function drawScrollIndicator()
    gpu.setBackground(0x1F1F2E)
    gpu.fill(BTN_UP_X - 1, HEADER_Y, 5, 1, " ")
    gpu.setForeground(scrollOffset > 0 and 0x64B5F6 or 0x3A3A4A)
    gpu.set(BTN_UP_X, HEADER_Y, "▲")
    gpu.setForeground(scrollOffset < maxScroll and 0x64B5F6 or 0x3A3A4A)
    gpu.set(BTN_DOWN_X, HEADER_Y, "▼")
end

local function draw()
    gpu.setBackground(0x14141C)
    gpu.fill(1, 1, w, h, " ")

    -- Шапка
    gpu.setBackground(0x1F1F2E)
    gpu.setForeground(0xFFFFFF)
    gpu.fill(1, HEADER_Y, w, 1, " ")
    gpu.set(2, HEADER_Y, "Singularity Creator")

    gpu.setBackground(0x2E7D32)
    gpu.fill(BTN_REFRESH_X1, HEADER_Y, BTN_REFRESH_X2 - BTN_REFRESH_X1, 1, " ")
    gpu.setForeground(0xFFFFFF)
    gpu.set(BTN_REFRESH_X1 + 2, HEADER_Y, "ОБНОВИТЬ")

    drawScrollIndicator()

    gpu.setBackground(0xC62828)
    gpu.fill(BTN_CANCEL_X1, HEADER_Y, BTN_CANCEL_X2 - BTN_CANCEL_X1, 1, " ")
    gpu.setForeground(0xFFFFFF)
    gpu.set(BTN_CANCEL_X1 + 3, HEADER_Y, " ОТМЕНА ")

    gpu.setBackground(0x2A2A3C)
    gpu.fill(1, SEP_Y, w, 1, " ")

    -- Заголовки колонок
    gpu.setBackground(0x1A1A28)
    gpu.setForeground(0x90A4AE)
    gpu.fill(1, COLHEAD_Y, w, 1, " ")
    gpu.set(3,  COLHEAD_Y, "Название")
    gpu.set(20, COLHEAD_Y, "Нужно")
    gpu.set(28, COLHEAD_Y, "Есть")
    gpu.set(38, COLHEAD_Y, "Можно")
    gpu.set(47, COLHEAD_Y, "Синг")
    for b = 1, 6 do
        gpu.set(COUNT_POS[b], COLHEAD_Y, tostring(COUNT_VAL[b]))
    end
    gpu.set(94, COLHEAD_Y, "В МЭ")

    -- Видимые строки
    for i = scrollOffset + 1, math.min(scrollOffset + VISIBLE_ROWS, #items) do
        drawRow(i, i == currentCraft)
    end

    if #items > VISIBLE_ROWS then
        setStatus(string.format("Готов к работе  |  показано %d-%d из %d",
            scrollOffset + 1, math.min(scrollOffset + VISIBLE_ROWS, #items), #items), 0x78909C)
    else
        setStatus("Готов к работе", 0x78909C)
    end
end

local function scroll(delta)
    if #items <= VISIBLE_ROWS then return end
    scrollOffset = scrollOffset + delta
    clampScroll()
    draw()
end

-- ============================================================
--  Крафт
-- ============================================================
local function doCraft(index, count)
    local item = items[index]
    if not item then return end

    crafting = true
    cancel = false
    currentCraft = index
    drawRow(index, true)

    local needed = item.need * count
    local have = getQty(item.block, item.dmg)

    if have < needed and item.ruda == 0 then
        local missing = needed - have
        setStatus("Заказываю в МЭ: " .. missing .. " × " .. item.name, 0xFFE082)
        pcall(function()
            ae.requestCrafting({id = item.block, dmg = item.dmg}, missing)
        end)
        os.sleep(0.1)
    end

    local dropped = 0
    while dropped < needed and not cancel do
        local e, _, x, y = event.pull(0, "touch")
        if e == "touch" and x >= BTN_CANCEL_X1 and y == HEADER_Y then
            cancel = true
            computer.beep(200, 0.05)
            break
        end

        local toTake = math.min(needed - dropped, 64)
        local got = exportItems(item.block, item.dmg, toTake)
        dropped = dropped + got

        local percent = math.floor(dropped / needed * 100)
        local barLen = 28
        local filled = math.floor(barLen * percent / 100)
        local bar = string.rep("█", filled) .. string.rep("░", barLen - filled)

        setStatus(string.format("%s  %d/%d (%d%%) %s", item.name, dropped, needed, percent, bar), 0x69F0AE)

        if got == 0 then
            os.sleep(0.03)
        end
    end

    currentCraft = 0
    drawRow(index, false)

    if cancel then
        setStatus("✖ ОТМЕНЕНО  |  " .. dropped .. " / " .. needed, 0xFF5252)
        computer.beep(180, 0.1)
    else
        setStatus("✔ ГОТОВО: " .. item.name .. " ×" .. count, 0x69F0AE)
        computer.beep(1000, 0.04)
        computer.beep(1400, 0.05)
    end

    crafting = false
    cancel = false
    os.sleep(0.7)
end

-- ============================================================
--  Главный цикл
-- ============================================================
term.clear()
draw()

while true do
    local e, _, x, y, direction = event.pull(0.2, "touch")
    if not e then
        e = select(1, event.pull(0, "scroll"))
    end

    if e == "touch" then
        if crafting then
            if x >= BTN_CANCEL_X1 and x <= BTN_CANCEL_X2 and y == HEADER_Y then
                cancel = true
                computer.beep(200, 0.05)
            end
        else
            if x >= BTN_REFRESH_X1 and x <= BTN_REFRESH_X2 and y == HEADER_Y then
                computer.beep(800, 0.02)
                updateNumbers()
            elseif x == BTN_UP_X and y == HEADER_Y then
                computer.beep(600, 0.02)
                scroll(-1)
            elseif x == BTN_DOWN_X and y == HEADER_Y then
                computer.beep(600, 0.02)
                scroll(1)
            else
                local idx = indexAtY(y)
                if idx then
                    -- Кнопка " + " занимает 3 символа: pos, pos+1, pos+2
                    for b = 1, 6 do
                        local px = COUNT_POS[b]
                        if x >= px and x <= px + 2 then
                            computer.beep(1000, 0.03)
                            doCraft(idx, COUNT_VAL[b])
                            break
                        end
                    end
                end
            end
        end
    elseif e == "scroll" and not crafting then
        scroll(direction and -direction or 0)
    end
end
