local function doCraft(index, count)
    local item = items[index]
    if not item then return end

    crafting = true
    cancel = false
    currentCraft = index
    drawRow(index, true)

    local needed = item.need * count
    local have = getQty(item.block, item.dmg)

    if have < needed and item.ruda == 0 then
        local missing = needed - have
        setStatus("Заказываю в МЭ: " .. missing .. " × " .. item.name, 0xFFE082)
        pcall(function()
            ae.requestCrafting({id = item.block, dmg = item.dmg}, missing)
        end)
        os.sleep(0.1)
    end

    local dropped = 0
    while dropped < needed and not cancel do
        local e, _, x, y = event.pull(0)
        if e == "touch" and x >= 138 and y == 1 then
            cancel = true
            computer.beep(200, 0.05)
            break
        end

        local toTake = math.min(needed - dropped, 64)
        local got = exportItems(item.block, item.dmg, toTake)
        dropped = dropped + got

        local percent = math.floor(dropped / needed * 100)
        local barLen = 28
        local filled = math.floor(barLen * percent / 100)
        local bar = string.rep("█", filled) .. string.rep("░", barLen - filled)

        setStatus(string.format("%s  %d/%d (%d%%) %s", item.name, dropped, needed, percent, bar), 0x69F0AE)

        if got == 0 then
            os.sleep(0.03)
        end
    end

    currentCraft = 0
    drawRow(index, false)

    if cancel then
        setStatus("✖ ОТМЕНЕНО  |  " .. dropped .. " / " .. needed, 0xFF5252)
        computer.beep(180, 0.1)
    else
        setStatus("✔ ГОТОВО: " .. item.name .. " ×" .. count, 0x69F0AE)
        computer.beep(1000, 0.04)
        computer.beep(1400, 0.05)
    end

    crafting = false
    cancel = false
    os.sleep(0.7)
end

term.clear()
draw()

while true do
    local e, _, x, y = event.pull(0.2, "touch")

    if e == "touch" then
        if crafting then
            if x >= 138 and x <= 158 and y == 1 then
                cancel = true
                computer.beep(200, 0.05)
            end
        else
            if x >= 120 and x <= 135 and y == 1 then
                computer.beep(800, 0.02)
                updateNumbers()
            elseif y >= 4 then
                -- Пересчитываем индекс с учётом отступов (каждая строка занимает 2 позиции)
                local idx = math.floor((y - 3) / 2)
                if idx >= 1 and idx <= #items then
                    local map = {
                        [56] = 1, [57] = 1, [58] = 1,
                        [62] = 3, [63] = 3, [64] = 3,
                        [68] = 5, [69] = 5, [70] = 5,
                        [74] = 10,[75] = 10,[76] = 10,
                        [80] = 20,[81] = 20,[82] = 20,
                        [86] = 50,[87] = 50,[88] = 50
                    }
                    local cnt = map[x]
                    if cnt then
                        computer.beep(1000, 0.03)
                        doCraft(idx, cnt)
                    end
                end
            end
        end
    end
end
