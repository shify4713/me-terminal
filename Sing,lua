-- ============================================================
--  Раскладка: карточная сетка (3 колонки)
-- ============================================================
local HEADER_Y       = 1
local CONTENT_TOP    = 2
local STATUS_Y       = h
local CONTENT_BOTTOM = h - 1

local COLUMNS  = 3
local MARGIN   = 1
local GAP_X    = 2
local GAP_Y    = 1
local CARD_H   = 5   -- ╭border, name, stats, buttons, ╰border
local CARD_W   = math.floor((w - 2 * MARGIN - (COLUMNS - 1) * GAP_X) / COLUMNS)
local INNER_W  = CARD_W - 2   -- ширина текста внутри рамки │...│

local ROWS_AVAILABLE = math.max(1, math.floor((CONTENT_BOTTOM - CONTENT_TOP + 1) / (CARD_H + GAP_Y)))
local ITEMS_PER_PAGE = ROWS_AVAILABLE * COLUMNS
local TOTAL_PAGES    = math.max(1, math.ceil(#items / ITEMS_PER_PAGE))

local BTN_REFRESH_X1, BTN_REFRESH_X2 = 100, 115
local BTN_PAGE_X1, BTN_PAGE_X2       = 117, 136
local BTN_CANCEL_X1, BTN_CANCEL_X2   = 138, 157

local COUNT_VAL   = {1, 3, 5, 10, 20, 50}
local COUNT_COLOR = {0x26A69A, 0x29B6F6, 0x66BB6A, 0xFFA726, 0xAB47BC, 0xEC407A}
local BTN_SLOT_W  = math.max(4, math.floor(INNER_W / #COUNT_VAL))

local crafting = false
local cancel = false
local currentCraft = 0
local page = 0   -- текущая страница, 0-индекс

local function clampPage()
    if page < 0 then page = 0 end
    if page > TOTAL_PAGES - 1 then page = TOTAL_PAGES - 1 end
end

-- Позиция карточки на экране по (col, row) — 0-индексы в пределах страницы
local function cardX(col) return MARGIN + col * (CARD_W + GAP_X) + 1 end
local function cardY(row) return CONTENT_TOP + row * (CARD_H + GAP_Y) end

-- ============================================================
--  Работа с ME
-- ============================================================
local function getQty(id, dmg)
    local ok, data = pcall(function()
        return ae.getItemDetail({id = id, dmg = dmg})
    end)
    if ok and data then
        return data.all().qty or 0
    end
    return 0
end

local function shortNum(n)
    if n >= 1000000 then
        return string.format("%.1fM", n / 1000000)
    elseif n >= 1000 then
        return string.format("%.1fk", n / 1000)
    else
        return tostring(n)
    end
end

local function padRight(s, len)
    s = tostring(s)
    if #s >= len then return s:sub(1, len) end
    return s .. string.rep(" ", len - #s)
end

local function exportItems(id, dmg, amount)
    local exported = 0
    local remaining = amount
    while remaining > 0 and not cancel do
        local ok, detail = pcall(function()
            return ae.getItemDetail({id = id, dmg = dmg})
        end)
        if not ok or not detail then break end
        local stack = detail.all()
        if not stack or not stack.qty or stack.qty <= 0 then break end

        local toExport = math.min(remaining, 64)
        local success, result = pcall(function()
            return ae.exportItem({id = id, dmg = dmg}, EXPORT_SIDE, toExport)
        end)

        if success and result and result.size and result.size > 0 then
            exported = exported + result.size
            remaining = remaining - result.size
        else
            success, result = pcall(function()
                return ae.exportItem(stack, EXPORT_SIDE, toExport)
            end)
            if success and result and result.size and result.size > 0 then
                exported = exported + result.size
                remaining = remaining - result.size
            else
                break
            end
        end

        local e, _, x, y = event.pull(0, "touch")
        if e == "touch" and x >= BTN_CANCEL_X1 and y == HEADER_Y then
            cancel = true
            computer.beep(200, 0.05)
            break
        end
    end
    return exported
end

local function setStatus(text, color)
    gpu.setBackground(0x1C1C28)
    gpu.setForeground(color or 0xDDDDDD)
    gpu.fill(1, STATUS_Y, w, 1, " ")
    gpu.set(2, STATUS_Y, text)
end

-- ============================================================
--  Отрисовка карточки
-- ============================================================
-- itemIndex — реальный индекс в items; posOnPage — 0-based позиция на странице
local function drawCard(itemIndex, posOnPage, highlight)
    local item = items[itemIndex]
    local col = posOnPage % COLUMNS
    local row = math.floor(posOnPage / COLUMNS)
    local cx, cy = cardX(col), cardY(row)

    local have = getQty(item.block, item.dmg)
    local can = math.floor(have / item.need)
    local sings = getQty(item.singu, item.sDmg)

    local accent, bg, borderFg
    if highlight then
        accent, bg, borderFg = 0x69F0AE, 0x1B5E20, 0x69F0AE
    elseif can > 0 then
        accent, bg, borderFg = 0x69F0AE, 0x18201C, 0x2E7D4F
    else
        accent, bg, borderFg = 0x546E7A, 0x181A20, 0x33404A
    end

    -- Рамка + фон
    gpu.setBackground(bg)
    gpu.fill(cx, cy, CARD_W, CARD_H, " ")

    gpu.setForeground(borderFg)
    gpu.set(cx, cy, "╭" .. string.rep("─", CARD_W - 2) .. "╮")
    gpu.set(cx, cy + 1, "│")
    gpu.set(cx + CARD_W - 1, cy + 1, "│")
    gpu.set(cx, cy + 2, "│")
    gpu.set(cx + CARD_W - 1, cy + 2, "│")
    gpu.set(cx, cy + 3, "│")
    gpu.set(cx + CARD_W - 1, cy + 3, "│")
    gpu.set(cx, cy + 4, "╰" .. string.rep("─", CARD_W - 2) .. "╯")

    -- Строка 1: акцент-метка + название + "Можно +N" справа
    gpu.setForeground(accent)
    gpu.set(cx + 1, cy + 1, "▎")
    gpu.setForeground(0xF5F5F5)
    local rightTxt = "+" .. can
    local nameW = INNER_W - 2 - #rightTxt - 1
    gpu.set(cx + 3, cy + 1, padRight(item.name, math.max(1, nameW)))
    gpu.setForeground(can > 0 and 0x69F0AE or 0xFF6E6E)
    gpu.set(cx + CARD_W - 1 - #rightTxt - 1, cy + 1, rightTxt)

    -- Строка 2: Нужно / Есть / Синг / В МЭ
    gpu.setForeground(0x90A4AE)
    local statsLine = string.format("Нужно %s  Есть %s  Синг %d  МЭ %s",
        shortNum(item.need), shortNum(have), sings, shortNum(have))
    gpu.set(cx + 2, cy + 2, padRight(statsLine, INNER_W - 2))

    -- Строка 3: кнопки
    for b = 1, #COUNT_VAL do
        local bx = cx + 1 + (b - 1) * BTN_SLOT_W
        gpu.setForeground(COUNT_COLOR[b])
        gpu.set(bx, cy + 3, padRight("+" .. COUNT_VAL[b], BTN_SLOT_W - 1))
    end
end

local function drawPageIndicator()
    local width = BTN_PAGE_X2 - BTN_PAGE_X1
    if TOTAL_PAGES <= 1 then
        gpu.setBackground(0x1F1F2E)
        gpu.fill(BTN_PAGE_X1, HEADER_Y, width, 1, " ")
        return
    end
    gpu.setBackground(0x263859)
    gpu.fill(BTN_PAGE_X1, HEADER_Y, width, 1, " ")
    gpu.setForeground(page > 0 and 0x64B5F6 or 0x546E7A)
    gpu.set(BTN_PAGE_X1 + 1, HEADER_Y, "◀")
    gpu.setForeground(0xCFD8DC)
    gpu.set(BTN_PAGE_X1 + 3, HEADER_Y, string.format("стр %d/%d", page + 1, TOTAL_PAGES))
    gpu.setForeground(page < TOTAL_PAGES - 1 and 0x64B5F6 or 0x546E7A)
    gpu.set(BTN_PAGE_X2 - 1, HEADER_Y, "▶")
end

local function draw()
    gpu.setBackground(0x101014)
    gpu.fill(1, 1, w, h, " ")

    -- Шапка
    gpu.setBackground(0x1F1F2E)
    gpu.setForeground(0xFFFFFF)
    gpu.fill(1, HEADER_Y, w, 1, " ")
    gpu.set(2, HEADER_Y, "◆ Singularity Creator")

    gpu.setBackground(0x2E7D32)
    gpu.fill(BTN_REFRESH_X1, HEADER_Y, BTN_REFRESH_X2 - BTN_REFRESH_X1, 1, " ")
    gpu.setForeground(0xFFFFFF)
    gpu.set(BTN_REFRESH_X1 + 2, HEADER_Y, "ОБНОВИТЬ")

    drawPageIndicator()

    gpu.setBackground(0xC62828)
    gpu.fill(BTN_CANCEL_X1, HEADER_Y, BTN_CANCEL_X2 - BTN_CANCEL_X1, 1, " ")
    gpu.setForeground(0xFFFFFF)
    gpu.set(BTN_CANCEL_X1 + 3, HEADER_Y, " ОТМЕНА ")

    -- Карточки текущей страницы
    local startIdx = page * ITEMS_PER_PAGE + 1
    local endIdx = math.min(startIdx + ITEMS_PER_PAGE - 1, #items)
    for i = startIdx, endIdx do
        drawCard(i, i - startIdx, i == currentCraft)
    end

    setStatus("Готов к работе", 0x78909C)
end

local function changePage(delta)
    if TOTAL_PAGES <= 1 then return end
    page = page + delta
    clampPage()
    draw()
end

-- Обновляет только цифры карточек текущей страницы
local function updateNumbers()
    local startIdx = page * ITEMS_PER_PAGE + 1
    local endIdx = math.min(startIdx + ITEMS_PER_PAGE - 1, #items)
    for i = startIdx, endIdx do
        drawCard(i, i - startIdx, i == currentCraft)
    end
    setStatus("Цифры обновлены", 0x80CBC4)
end

-- Определяет индекс предмета по клику (x, y), либо nil.
-- Возвращает также номер нажатой кнопки количества (1..6), либо nil.
local function hitTest(x, y)
    if y < CONTENT_TOP or y > CONTENT_BOTTOM then return nil end

    local localY = y - CONTENT_TOP
    local rowStep = CARD_H + GAP_Y
    local row = math.floor(localY / rowStep)
    local rowOffset = localY - row * rowStep
    if rowOffset >= CARD_H then return nil end   -- клик в межрядном зазоре

    local localX = x - MARGIN - 1
    if localX < 0 then return nil end
    local colStep = CARD_W + GAP_X
    local col = math.floor(localX / colStep)
    local colOffset = localX - col * colStep
    if col < 0 or col >= COLUMNS or colOffset >= CARD_W then return nil end

    local posOnPage = row * COLUMNS + col
    local itemIndex = page * ITEMS_PER_PAGE + posOnPage + 1
    if itemIndex < 1 or itemIndex > #items then return nil end
    if posOnPage >= ITEMS_PER_PAGE then return nil end

    local btn = nil
    if rowOffset == 3 then   -- строка кнопок внутри карточки
        local bx = colOffset - 1
        if bx >= 0 then
            local b = math.floor(bx / BTN_SLOT_W) + 1
            local within = bx - (b - 1) * BTN_SLOT_W
            if b >= 1 and b <= #COUNT_VAL and within < BTN_SLOT_W - 1 then
                btn = b
            end
        end
    end

    return itemIndex, btn
end

-- ============================================================
--  Крафт
-- ============================================================
local function doCraft(index, count)
    local item = items[index]
    if not item then return end

    crafting = true
    cancel = false
    currentCraft = index
    local startIdx = page * ITEMS_PER_PAGE + 1
    drawCard(index, index - startIdx, true)

    local needed = item.need * count
    local have = getQty(item.block, item.dmg)

    if have < needed and item.ruda == 0 then
        local missing = needed - have
        setStatus("Заказываю в МЭ: " .. missing .. " × " .. item.name, 0xFFE082)
        pcall(function()
            ae.requestCrafting({id = item.block, dmg = item.dmg}, missing)
        end)
        os.sleep(0.1)
    end

    local dropped = 0
    while dropped < needed and not cancel do
        local e, _, x, y = event.pull(0, "touch")
        if e == "touch" and x >= BTN_CANCEL_X1 and y == HEADER_Y then
            cancel = true
            computer.beep(200, 0.05)
            break
        end

        local toTake = math.min(needed - dropped, 64)
        local got = exportItems(item.block, item.dmg, toTake)
        dropped = dropped + got

        local percent = math.floor(dropped / needed * 100)
        local barLen = 28
        local filled = math.floor(barLen * percent / 100)
        local bar = string.rep("█", filled) .. string.rep("░", barLen - filled)

        setStatus(string.format("%s  %d/%d (%d%%) %s", item.name, dropped, needed, percent, bar), 0x69F0AE)

        if got == 0 then
            os.sleep(0.03)
        end
    end

    currentCraft = 0
    drawCard(index, index - startIdx, false)

    if cancel then
        setStatus("✖ ОТМЕНЕНО  |  " .. dropped .. " / " .. needed, 0xFF5252)
        computer.beep(180, 0.1)
    else
        setStatus("✔ ГОТОВО: " .. item.name .. " ×" .. count, 0x69F0AE)
        computer.beep(1000, 0.04)
        computer.beep(1400, 0.05)
    end

    crafting = false
    cancel = false
    os.sleep(0.7)
end

-- ============================================================
--  Главный цикл
-- ============================================================
term.clear()
draw()

while true do
    local e, _, x, y, p5 = event.pull(0.2)

    if e == "touch" then
        if crafting then
            if x >= BTN_CANCEL_X1 and x <= BTN_CANCEL_X2 and y == HEADER_Y then
                cancel = true
                computer.beep(200, 0.05)
            end
        else
            if x >= BTN_REFRESH_X1 and x <= BTN_REFRESH_X2 and y == HEADER_Y then
                computer.beep(800, 0.02)
                updateNumbers()
            elseif x >= BTN_PAGE_X1 and x <= BTN_PAGE_X2 and y == HEADER_Y then
                computer.beep(600, 0.02)
                local mid = (BTN_PAGE_X1 + BTN_PAGE_X2) / 2
                changePage(x < mid and -1 or 1)
            else
                local idx, btn = hitTest(x, y)
                if idx and btn then
                    computer.beep(1000, 0.03)
                    doCraft(idx, COUNT_VAL[btn])
                end
            end
        end
    elseif e == "scroll" and not crafting then
        changePage(p5 and -p5 or 0)
    end
end
